<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.krivega.agent-workflow.tnas-tunnel</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/ssh</string>
		<string>-NT</string>
		<string>-o</string>
		<string>BatchMode=yes</string>
		<string>-o</string>
		<string>StrictHostKeyChecking=yes</string>
		<string>-o</string>
		<string>ExitOnForwardFailure=yes</string>
		<string>-o</string>
		<string>ServerAliveInterval=30</string>
		<string>-o</string>
		<string>ServerAliveCountMax=3</string>
		<string>-o</string>
		<string>ForwardAgent=no</string>
		<string>-o</string>
		<string>ControlMaster=no</string>
		<string>-o</string>
		<string>ControlPath=none</string>
		<string>-L</string>
		<string>127.0.0.1:7233:127.0.0.1:7233</string>
		<string>-p</string>
		<string>9222</string>
		<string>user@nas.example</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/absolute/private/host/tunnel.stderr.log</string>
	<key>ThrottleInterval</key>
	<integer>15</integer>
</dict>
</plist>
